# Copy to .env.local for development (pnpm dev:stack writes one for you). Never commit real values.
# There are deliberately no NEXT_PUBLIC_* variables: nothing here is exposed to the browser.

# --- Database (runtime) ---------------------------------------------------------------------------
# Least-privilege role for the staff workspace and API.
DATABASE_URL=postgres://app_server:CHANGE_ME@127.0.0.1:5432/authenticity_dev
# Public verification path: can execute only verify_part_token and rate_limit_hit. Strongly recommended.
VERIFIER_DATABASE_URL=postgres://app_verifier:CHANGE_ME@127.0.0.1:5432/authenticity_dev
# disable | verify | no-verify. Default: disable for localhost, verify elsewhere. no-verify is refused in production.
#DATABASE_SSL=verify
#DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#DATABASE_POOL_MAX=5

# --- Supabase ---------------------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=CHANGE_ME_at_least_20_characters
# Server-only. Bypasses RLS and administers users.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_at_least_20_characters

# --- Site -----------------------------------------------------------------------------------------
# Encoded inside every printed QR code. https in production; choose a domain you will keep for decades.
PUBLIC_SITE_URL=http://localhost:3000
# >= 32 random characters. Keys the network hash used for repeat-scan analysis (openssl rand -base64 48).
NETWORK_HASH_PEPPER=CHANGE_ME_at_least_32_random_characters_long

# --- Storage ----------------------------------------------------------------------------------------
# supabase (production) | local (development only; refused in production)
ARTIFACT_STORAGE=local
LOCAL_STORAGE_DIR=.local-storage

# --- Operations -------------------------------------------------------------------------------------
# >= 24 random characters. Required in production; the cron route refuses everything without it.
#CRON_SECRET=
# true: owners and admins must enrol an authenticator. An enrolled factor is always enforced regardless.
REQUIRE_MFA_FOR_PRIVILEGED=false

# --- Scripts only (migrate, bootstrap-owner, seed-dev, e2e). NEVER set in the deployed application. -----
#DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/authenticity_dev
